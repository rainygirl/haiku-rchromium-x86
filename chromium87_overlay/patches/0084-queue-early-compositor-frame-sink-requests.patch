+  if (!frame_sink_manager_) {
+    // Keep the request until the FrameSinkManager is connected, instead of
+    // letting the receiver die here.
+    //
+    // Dropping it is not harmless. The renderer's AsyncLayerTreeFrameSink
+    // sees the closed pipe as a connection error, reports
+    // DidLoseLayerTreeFrameSink(), and requests a new sink on the very next
+    // commit -- there is no backoff anywhere in that path. If the manager is
+    // still not connected, the new request is dropped too, and the renderer
+    // main thread, the browser UI thread and both IO threads spend every
+    // cycle creating and tearing down message pipes. On a two-core Atom that
+    // starves the in-process GPU thread whose job it is to *make* the
+    // connection, so the state never resolves: the window shows the one
+    // frame the root surface painted and Blink resolves no styles at all.
+    // Measured on this machine at 3/6, then 0/10 launches, with the two hot
+    // threads' stacks both inside RequestNewLayerTreeFrameSink.
+    //
+    // Fast machines never hit this because viz connects before any renderer
+    // asks, which is the assumption the upstream code makes silently.
+    static bool reported = false;
+    if (!reported) {
+      reported = true;
+      fprintf(stderr, "[RCH] CompositorFrameSink request for %s arrived "
+              "before the FrameSinkManager was connected; queued\n",
+              frame_sink_id.ToString().c_str());
+    }
+    PendingCreate pending;
+    pending.frame_sink_id = frame_sink_id;
+    pending.receiver = std::move(receiver);
+    pending.client = std::move(client);
+    pending_creates_.push_back(std::move(pending));
+    return;
+  }
+
+  data.is_root = false;
+  data.has_created_compositor_frame_sink = true;
+  frame_sink_manager_->CreateCompositorFrameSink(
       frame_sink_id, std::move(receiver), std::move(client));
+}
+
+HostFrameSinkManager::PendingCreate::PendingCreate() = default;
+HostFrameSinkManager::PendingCreate::PendingCreate(PendingCreate&&) = default;
+HostFrameSinkManager::PendingCreate::~PendingCreate() = default;
+
+void HostFrameSinkManager::FlushPendingCreates() {
+  std::vector<PendingCreate> pending = std::move(pending_creates_);
+  pending_creates_.clear();
+  for (PendingCreate& p : pending) {
+    CreateCompositorFrameSink(p.frame_sink_id, std::move(p.receiver),
+                              std::move(p.client));
   }
 }
 
