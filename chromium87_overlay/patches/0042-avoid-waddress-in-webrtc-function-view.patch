           nullptr>
   FunctionView(F&& f)
-      : call_(f ? CallFunPtr<typename std::remove_pointer<F>::type> : nullptr) {
+      : call_(function_view_internal::IsNotNull(f)
+                  ? CallFunPtr<typename std::remove_pointer<F>::type>
+                  : nullptr) {
     f_.fun_ptr = reinterpret_cast<void (*)()>(f);
   }
 
