--- a/third_party/fontconfig/BUILD.gn
+++ b/third_party/fontconfig/BUILD.gn
@@ -108,6 +108,17 @@
     if (!is_win) {
       libs = [ "uuid" ]
     }
+
+    # fontconfig calls dgettext() for the strings it reports through
+    # FcConfigFileInfoIterGet(). On Linux that symbol comes from libc, so
+    # nothing has to be linked for it. Haiku keeps gettext in a separate
+    # library (the gettext_x86_libintl package), and its libintl.h redirects
+    # dgettext to libintl_dgettext, so the bundled fontconfig leaves
+    # libintl_dgettext undefined at the final link unless -lintl is on the
+    # line. /boot/system/lib/x86/libintl.so.8.4.6 exports it.
+    if (is_haiku) {
+      libs += [ "intl" ]
+    }
   }
 } else {
   config("fontconfig_config") {
